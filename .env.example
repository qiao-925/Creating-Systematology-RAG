# Systematology 环境变量模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env
# 或使用 gh token 自动同步：uv run python scripts/env_sync.py pull

# ============================================================================
# 必选配置
# ============================================================================

# DeepSeek API 密钥（必需）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx

# ============================================================================
# 可选配置
# ============================================================================

# Chroma Cloud 向量数据库（可选，不填则使用本地 Chroma）
CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_TENANT=
CHROMA_CLOUD_DATABASE=

# HuggingFace API Token（可选，用于 HF Inference API）
# 获取地址：https://huggingface.co/settings/tokens
HF_TOKEN=

# 重排序模型路径（可选，留空则使用默认 Embedding 模型）
RERANK_MODEL=
